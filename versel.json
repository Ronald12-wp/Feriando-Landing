{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/apk/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=feriando-v1.0.0.apk"
        }
      ]
    }
  ]
}